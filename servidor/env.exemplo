# Exemplo do arquivo /etc/relatorios-engie/env. Os valores abaixo são fictícios.
# O instalar.sh cria o env real fazendo perguntas; use este arquivo só como referência.
# Regras: uma variável por linha, sem espaços ao redor do "=". Valores com caracteres
# especiais vão entre aspas simples, e o valor não pode conter aspas simples.
# O arquivo real tem credenciais: permissão 600 e nunca no repositório.

# --- Obrigatórias -----------------------------------------------------------

# Arquivo do banco SQLite
DISP_DB=/etc/relatorios-engie/disponibilidade.db

# IP deste servidor: onde a API (8099) e o painel (8098) atendem; também vai nos dashboards
SERVIDOR_IP=192.0.2.10

# Frontend do Zabbix e token de API (Users > API tokens)
ZABBIX_URL=https://zabbix.exemplo.com.br
ZABBIX_TOKEN=COLE_O_TOKEN_AQUI

# --- TOPdesk: necessárias para os chamados entrarem nos relatórios ----------

TOPDESK_URL=https://exemplo.topdesk.net
TOPDESK_USER=usuario_api
TOPDESK_APP_PASSWORD=COLE_A_SENHA_DE_APLICACAO_AQUI

# --- Opcionais: tire o # para usar ------------------------------------------

# 0 desliga a verificação do certificado (padrão: 1, verifica)
#ZABBIX_VERIFY_TLS=0
#TOPDESK_VERIFY_TLS=0

# IP do nome do Zabbix no /etc/hosts, se o DNS não resolver. Aplicado pelo instalar.sh
#ZABBIX_FRONTEND_IP=192.0.2.20

# Atalho do Grafana no menu do painel
#GRAFANA_URL=http://192.0.2.20:3000

# Pasta dos PDFs (padrão: /etc/relatorios-engie/pdf)
#PDF_DIR=/etc/relatorios-engie/pdf

# Formato do número do chamado nos comentários do Zabbix; o 1º grupo é o número
#CHAMADO_REGEX='(I\d{4}-\d+)'

# Exige o header "Authorization: Bearer <token>" na API. Configure o mesmo token no Grafana
#API_TOKEN=COLE_UM_TOKEN_AQUI

# Painel em HTTPS
#ADMIN_TLS_CERT=/etc/relatorios-engie/tls/painel.crt
#ADMIN_TLS_KEY=/etc/relatorios-engie/tls/painel.key
