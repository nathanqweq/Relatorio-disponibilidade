              "options": {
                "afterRender": "",
                "content": "{{#with data.[0]}}\n<div class=\"kpis\">\n  <div class=\"kpi\">\n    <div class=\"titulo\">Disponibilidade Geral</div>\n    <table>\n      <thead><tr><th>Disponibilidade</th><th>Mês</th><th>Ano</th></tr></thead>\n      <tbody><tr>\n        <td class=\"valor{{#if (abaixo GERAL)}} alerta{{/if}}{{#if (nulo GERAL)}} sem{{/if}}\">{{pct GERAL}}</td>\n        <td>{{MES}}</td>\n        <td>{{ANO}}</td>\n      </tr></tbody>\n    </table>\n  </div>\n  <div class=\"kpi\">\n    <div class=\"titulo\">Disponibilidade geral usinas</div>\n    <table>\n      <thead><tr><th>Disponibilidade</th><th>Mês</th><th>Ano</th></tr></thead>\n      <tbody><tr>\n        <td class=\"valor{{#if (abaixo GERACAO)}} alerta{{/if}}{{#if (nulo GERACAO)}} sem{{/if}}\">{{pct GERACAO}}</td>\n        <td>{{MES}}</td>\n        <td>{{ANO}}</td>\n      </tr></tbody>\n    </table>\n  </div>\n  <div class=\"kpi\">\n    <div class=\"titulo\">Disponibilidade geral usinas transmissão</div>\n    <table>\n      <thead><tr><th>Disponibilidade</th><th>Mês</th><th>Ano</th></tr></thead>\n      <tbody><tr>\n        <td class=\"valor{{#if (abaixo TRANSMISSAO)}} alerta{{/if}}{{#if (nulo TRANSMISSAO)}} sem{{/if}}\">{{pct TRANSMISSAO}}</td>\n        <td>{{MES}}</td>\n        <td>{{ANO}}</td>\n      </tr></tbody>\n    </table>\n  </div>\n  <div class=\"kpi\">\n    <div class=\"titulo\">Disponibilidade Geral das Aplicações</div>\n    <table>\n      <thead><tr><th>Disponibilidade</th><th>Mês</th><th>Ano</th></tr></thead>\n      <tbody><tr>\n        <td class=\"valor{{#if (abaixo TID_APLICACOES)}} alerta{{/if}}{{#if (nulo TID_APLICACOES)}} sem{{/if}}\">{{pct TID_APLICACOES}}</td>\n        <td>{{MES}}</td>\n        <td>{{ANO}}</td>\n      </tr></tbody>\n    </table>\n  </div>\n</div>\n{{/with}}",
                "contentPartials": [],
                "defaultContent": "<div class=\"vazio\">Sem dados para o período selecionado.</div>",
                "editor": {
                  "format": "auto",
                  "language": "html"
                },
                "editors": [
                  "helpers",
                  "styles"
                ],
                "externalStyles": [],
                "helpers": "const MESES = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho',\n               'Agosto','Setembro','Outubro','Novembro','Dezembro'];\n\ncontext.handlebars.registerHelper('pct', v => {\n  if (v === null || v === undefined || v === '' || isNaN(Number(v))) return '—';\n  const n = Number(v);\n  if (n >= 100) return '100%';\n  return n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';\n});\ncontext.handlebars.registerHelper('abaixo', v => v !== null && v !== undefined && Number(v) < 100);\ncontext.handlebars.registerHelper('nulo', v => v === null || v === undefined || v === '' || isNaN(Number(v)));\ncontext.handlebars.registerHelper('mes', v => MESES[Number(v) - 1] || v);\n",
                "renderMode": "allRows",
                "styles": "\n.kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; height: 100%; }\n@media (max-width: 900px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n.kpi { border: 1px solid rgba(128,128,128,.25); border-top: 3px solid #00AAFF; border-radius: 6px;\n       padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }\n.kpi .titulo { font-size: 12px; font-weight: 600; opacity: .8; }\n.kpi table { width: 100%; border-collapse: collapse; }\n.kpi th { font-size: 10px; text-transform: uppercase; letter-spacing: .04em; opacity: .6;\n          text-align: center; font-weight: 600; padding-bottom: 2px; }\n.kpi td { text-align: center; font-size: 15px; font-variant-numeric: tabular-nums; }\n.kpi td.valor { font-size: 26px; font-weight: 700; color: #73BF69; }\n.kpi td.valor.alerta { color: #F2495C; }\n.kpi td.valor.sem { color: inherit; opacity: .45; }\n",
                "wrap": false
              }
